// Topic: 2D Array 90 Degree Rotation

#include <iostream>
using namespace std;

int main() {
    int a[10][10], b[10][10], n;

    cout << "Enter order of matrix: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            b[j][n - 1 - i] = a[i][j];

    cout << "Rotated matrix:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            cout << b[i][j] << " ";
        cout << endl;
    }

    return 0;
}