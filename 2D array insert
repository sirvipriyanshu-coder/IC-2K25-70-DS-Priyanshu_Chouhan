// Topic: 2D Array Insertion

#include <iostream>
using namespace std;

int main() {
    int a[10][10], r, c, pos1, pos2, val;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter elements: ";
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            cin >> a[i][j];

    cout << "Enter row, column and value: ";
    cin >> pos1 >> pos2 >> val;

    a[pos1 - 1][pos2 - 1] = val;

    cout << "Matrix:\n";
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++)
            cout << a[i][j] << " ";
        cout << endl;
    }

    return 0;
}