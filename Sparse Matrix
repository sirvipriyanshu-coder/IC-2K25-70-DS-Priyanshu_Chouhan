// Topic: Sparse Matrix Representation Using Triple Format

#include <iostream>
using namespace std;

int main() {
    int a[10][10], t[100][3];
    int r, c, k = 1;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter elements: ";
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            cin >> a[i][j];

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (a[i][j] != 0) {
                t[k][0] = i;
                t[k][1] = j;
                t[k][2] = a[i][j];
                k++;
            }
        }
    }

    t[0][0] = r;
    t[0][1] = c;
    t[0][2] = k - 1;

    cout << "Row Column Value\n";
    for (int i = 0; i < k; i++)
        cout << t[i][0] << " "
             << t[i][1] << " "
             << t[i][2] << endl;

    return 0;
}