// Topic: 2D Array Searching

#include <iostream>
using namespace std;

int main() {
    int a[10][10], r, c, key, found = 0;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter elements: ";
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            cin >> a[i][j];

    cout << "Enter element to search: ";
    cin >> key;

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            if (a[i][j] == key) {
                cout << "Found at position "
                     << i + 1 << "," << j + 1;
                found = 1;
                break;
            }
        }
        if (found)
            break;
    }

    if (!found)
        cout << "Element not found";

    return 0;
}